+/* Single neutral button variant */
+.theme-toggle.single-theme-toggle {
+  width: 44px;
+  height: 44px;
+  border-radius: 999px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  background: #2f333a;
+  border: 1px solid #4e5662;
+  color: #d3d8e0;
+  padding: 0;
+  box-shadow:
+    7px 7px 14px rgba(0, 0, 0, 0.42),
+    -6px -6px 12px rgba(255, 255, 255, 0.03),
+    inset 1px 1px 0 rgba(255, 255, 255, 0.06),
+    inset -1px -1px 0 rgba(0, 0, 0, 0.35);
+}
+
+.theme-toggle.single-theme-toggle::before {
+  content: none;
+}
+
+.theme-toggle.single-theme-toggle .theme-icon {
+  position: static;
+  transform: none;
+  width: auto;
+  height: auto;
+  font-size: 17px;
+  opacity: 1;
+  color: #d3d8e0;
+  transition: color 0.25s ease;
+}
+
+.theme-toggle.single-theme-toggle:hover {
+  border-color: #656f7d;
+  background: #343941;
+  box-shadow:
+    8px 8px 16px rgba(0, 0, 0, 0.46),
+    -7px -7px 14px rgba(255, 255, 255, 0.04),
+    inset 1px 1px 0 rgba(255, 255, 255, 0.08),
+    inset -1px -1px 0 rgba(0, 0, 0, 0.4);
+}
+
+[data-theme="light"] .theme-toggle.single-theme-toggle {
+  background: #e9edf2;
+  border-color: #b5beca;
+  color: #616a78;
+  box-shadow:
+    6px 6px 14px rgba(163, 177, 198, 0.45),
+    -6px -6px 14px rgba(255, 255, 255, 0.95),
+    inset 1px 1px 0 rgba(255, 255, 255, 0.9),
+    inset -1px -1px 0 rgba(182, 192, 206, 0.5);
+}
+
+[data-theme="light"] .theme-toggle.single-theme-toggle .theme-icon {
+  color: #616a78;
+}
+
+[data-theme="light"] .theme-toggle.single-theme-toggle:hover {
+  background: #f0f3f7;
+  border-color: #aab3c1;
+  box-shadow:
+    7px 7px 16px rgba(163, 177, 198, 0.48),
+    -7px -7px 16px rgba(255, 255, 255, 0.98),
+    inset 1px 1px 0 rgba(255, 255, 255, 0.96),
+    inset -1px -1px 0 rgba(182, 192, 206, 0.55);
+}
+
+.theme-toggle.single-theme-toggle.animating {
+  animation: themeButtonPress 260ms ease;
+}
+
+.theme-toggle.single-theme-toggle.animating .theme-icon {
+  animation: themeIconFlip 280ms ease;
+}
+
+@keyframes themeButtonPress {
+  0% {
+    transform: translateY(0) scale(1);
+  }
+  45% {
+    transform: translateY(1px) scale(0.94);
+  }
+  100% {
+    transform: translateY(0) scale(1);
+  }
+}
+
+@keyframes themeIconFlip {
+  0% {
+    transform: scale(1) rotate(0deg);
+  }
+  50% {
+    transform: scale(0.72) rotate(-14deg);
+  }
+  100% {
+    transform: scale(1) rotate(0deg);
+  }
+}
+
 .theme-toggle .sun {
   left: calc(var(--toggle-pad) + (var(--toggle-knob) - 18px) / 2);
 }
